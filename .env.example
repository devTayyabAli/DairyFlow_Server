PORT=3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dairyflow
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars
CORS_ORIGIN=*

# Email delivery for registration OTP codes.
# Leave SMTP_HOST empty in development: the code is printed in the server console instead.
# In production these are required (e.g. Gmail app password, Brevo, Resend SMTP, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DairyFlow <no-reply@yourdomain.com>"
OTP_TTL_MINUTES=10
