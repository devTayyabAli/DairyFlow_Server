# See README.md ("Environment variables") for details. Copy to .env and edit.
NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=dairyflow
MONGODB_MAX_POOL_SIZE=20
MONGODB_SERVER_SELECTION_TIMEOUT_MS=10000

# REQUIRED in production: random, at least 32 characters (e.g. `openssl rand -hex 48`).
# Without it a built-in development secret is used and a loud warning is printed.
JWT_SECRET=replace_with_a_secure_random_jwt_secret_min_32_chars

# Comma-separated allow-list of browser origins, e.g. https://app.example.com,https://admin.example.com
# "*" is rejected in production unless CORS_ALLOW_ANY_IN_PRODUCTION=true.
# (The native mobile app does not send an Origin header and is not affected by CORS.)
CORS_ORIGIN=*
CORS_ALLOW_ANY_IN_PRODUCTION=false

# Set when running behind a reverse proxy / load balancer so rate limits use the real client IP:
#   false (default) | true | <number of proxy hops, e.g. 1> | comma-separated proxy IPs/CIDRs
TRUST_PROXY=false

# fatal | error | warn | info (default) | debug | trace | silent
LOG_LEVEL=info

# Email delivery for OTP codes (registration and password reset).
# Leave SMTP_HOST empty in development: the code is printed in the server console instead.
# REQUIRED in production (e.g. Gmail app password, Brevo, Resend SMTP, Mailgun...).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="DairyFlow <no-reply@yourdomain.com>"
OTP_TTL_MINUTES=10
