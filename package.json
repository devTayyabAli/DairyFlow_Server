{
  "name": "dairyflow-backend",
  "version": "1.0.0",
  "description": "DairyFlow backend API with Fastify and MongoDB",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node api.js && tsx watch src/server.ts",
    "build": "node api.js && tsc",
    "start": "node api.js && node dist/server.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.2.0",
    "@fastify/jwt": "^9.0.4",
    "@fastify/rate-limit": "^10.1.1",
    "bcryptjs": "^2.4.3",
    "dotenv": "^16.4.7",
    "fastify": "^5.2.1",
    "mongodb": "^6.13.0",
    "nodemailer": "^10.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.4",
    "@vercel/node": "^24.0.1",
    "mongodb-memory-server": "^10.1.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vitest": "^3.0.5"
  }
}
